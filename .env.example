# Database Configuration (for local development only)
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=devops_db
DB_HOST=127.0.0.1
DB_PORT=5432

# Application Configuration
NODE_ENV=development
PORT=3000

# S3 uploads — via LocalStack for local dev (docker-compose sets AWS_ENDPOINT_URL
# automatically; real AWS deployments should leave AWS_ENDPOINT_URL unset)
AWS_REGION=us-east-1
S3_UPLOADS_BUCKET=devops-articles-uploads

# LocalStack auth token (from your LocalStack account) — used only by the
# localstack service in docker-compose, not read by the app itself
LOCALSTACK_AUTH_TOKEN=your_localstack_auth_token